# ─── Supabase Auth ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database ───
DATABASE_URL=postgresql://user:password@localhost:5432/convocarry

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/dashboard
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/dashboard?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/dashboard?checkout=canceled

# ─── API ───
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your-32-byte-long-secure-random-secret
JWT_EXPIRES_IN=7d
CRON_SECRET=your-16-byte-long-cron-secret

# ─── Extension ───
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google access-token exchange: must match the extension's public client ID.
GOOGLE_CLIENT_ID=
# Extension build variables belong in apps/extension/.env.local.
# See apps/extension/.env.example.
